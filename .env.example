# Copy this file to .env and fill in your value. Never commit .env.
#
# Generate this from account.upstox.com -> Developer Apps -> your app -> Analytics tab -> Generate Token.
# It is read-only, valid for 1 year, and needs no daily login/OAuth refresh.
UPSTOX_ANALYTICS_TOKEN=your_analytics_token_here

# Where the NSE equity instrument master gets cached after each refresh.
INSTRUMENT_CACHE_PATH=data/nse_equity_instruments.json
